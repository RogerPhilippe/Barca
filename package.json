{
  "name": "barca",
  "productName": "Barca",
  "version": "1.0.0",
  "description": "Cliente FTP, FTPS e SFTP moderno para macOS",
  "main": "src/main/main.js",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "bash scripts/make-icon.sh",
    "dist": "node scripts/package.js all",
    "dist:mac": "node scripts/package.js mac",
    "dist:win": "node scripts/package.js win",
    "dist:linux": "node scripts/package.js linux",
    "test": "node test/backend.test.js",
    "test:smoke": "electron test/smoke.js"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "ftp-srv": "^4.6.3"
  },
  "allowScripts": {
    "cpu-features": false,
    "ssh2": false
  },
  "author": "Roger Philippe Pereira <rogerphilippepereira@gmail.com>"
}
